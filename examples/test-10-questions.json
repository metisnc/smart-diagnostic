{
	"schemaVersion": 1,
	"meta": {
		"title": "Test – Présence en ligne (10 questions)",
		"description": "Parcours de test de bout en bout : tous les types courants, condition, saut, réponse « Je ne sais pas », 3 axes, formule, profils, CTA conditionnels."
	},
	"i18n": { "defaultLanguage": "fr", "languages": [ "fr" ] },
	"welcome": {
		"title": "Votre entreprise est-elle visible en ligne ?",
		"subtitle": "10 questions, 3 minutes : obtenez votre score de présence en ligne et un plan d'action personnalisé.",
		"benefits": [
			"Score sur 3 axes : visibilité, conversion, fidélisation",
			"Plan d'action adapté à votre situation",
			"Résultat envoyé par email"
		],
		"badges": [ "Gratuit", "3 minutes" ],
		"startLabel": "Je fais le test"
	},
	"flow": {
		"progress": { "bar": true, "counter": true, "sectionName": true },
		"backButton": true,
		"saveProgress": true,
		"autoAdvance": true,
		"optionLetters": true,
		"encouragements": [
			{
				"atPercent": 40,
				"text": "Bien joué {first_name}, vous avancez vite !"
			},
			{ "atPercent": 75, "text": "Plus que quelques questions…" }
		],
		"transition": {
			"enabled": true,
			"durationMs": 3000,
			"steps": [
				"Analyse de vos réponses…",
				"Calcul de vos scores…",
				"Préparation de votre plan d'action…"
			]
		}
	},
	"sections": [
		{ "key": "entreprise", "label": "Votre entreprise" },
		{ "key": "visibilite", "label": "Visibilité" },
		{ "key": "clients", "label": "Vos clients" },
		{ "key": "objectifs", "label": "Vos objectifs" }
	],
	"axes": [
		{
			"key": "visibilite",
			"label": "Visibilité",
			"base": 0,
			"min": 0,
			"max": 100
		},
		{
			"key": "conversion",
			"label": "Conversion",
			"base": 0,
			"min": 0,
			"max": 100
		},
		{
			"key": "fidelisation",
			"label": "Fidélisation",
			"base": 0,
			"min": 0,
			"max": 100
		}
	],
	"steps": [
		{
			"key": "first_name",
			"kind": "question",
			"section": "entreprise",
			"type": "text",
			"label": "Pour commencer, quel est votre prénom ?",
			"placeholder": "Votre prénom",
			"required": false,
			"validation": { "maxLength": 50 }
		},
		{
			"key": "secteur",
			"kind": "question",
			"section": "entreprise",
			"type": "dropdown",
			"label": "Dans quel secteur travaillez-vous, {first_name} ?",
			"placeholder": "Choisissez votre secteur",
			"options": [
				{ "value": "commerce", "label": "Commerce / boutique" },
				{
					"value": "restauration",
					"label": "Restauration / hôtellerie"
				},
				{ "value": "artisanat", "label": "Artisanat / BTP" },
				{ "value": "services", "label": "Services aux entreprises" },
				{ "value": "sante", "label": "Santé / bien-être" },
				{ "value": "autre", "label": "Autre" }
			]
		},
		{
			"key": "site_web",
			"kind": "question",
			"section": "visibilite",
			"type": "yes_no",
			"label": "Avez-vous un site internet ?",
			"options": [
				{
					"value": true,
					"label": "Oui",
					"scores": { "visibilite": 20, "conversion": 10 }
				},
				{ "value": false, "label": "Non" }
			],
			"jumpTo": [
				{
					"if": {
						"left": "answer.site_web",
						"op": "eq",
						"value": false
					},
					"to": "canaux"
				}
			]
		},
		{
			"key": "visites",
			"kind": "question",
			"section": "visibilite",
			"type": "number",
			"label": "Combien de visites reçoit votre site par mois (environ) ?",
			"help": "Une estimation suffit. Question affichée seulement si vous avez un site.",
			"unit": "visites / mois",
			"showIf": { "left": "answer.site_web", "op": "eq", "value": true },
			"validation": { "min": 0, "max": 1000000 }
		},
		{
			"key": "canaux",
			"kind": "question",
			"section": "visibilite",
			"type": "multi",
			"label": "Où vos clients peuvent-ils vous trouver en ligne ?",
			"help": "Plusieurs réponses possibles.",
			"options": [
				{
					"value": "google",
					"label": "Fiche Google (Google Business Profile)",
					"scores": { "visibilite": 15 }
				},
				{
					"value": "facebook",
					"label": "Facebook",
					"scores": { "visibilite": 5 }
				},
				{
					"value": "instagram",
					"label": "Instagram",
					"scores": { "visibilite": 5 }
				},
				{
					"value": "linkedin",
					"label": "LinkedIn",
					"scores": { "visibilite": 5 }
				},
				{
					"value": "annuaires",
					"label": "Annuaires / plateformes (PagesJaunes, TripAdvisor…)",
					"scores": { "visibilite": 5 }
				},
				{
					"value": "aucun",
					"label": "Nulle part pour l'instant",
					"exclusive": true
				}
			],
			"validation": { "maxSelected": 5 }
		},
		{
			"key": "publication",
			"kind": "question",
			"section": "visibilite",
			"type": "single",
			"label": "À quelle fréquence publiez-vous sur vos réseaux sociaux ?",
			"options": [
				{
					"value": "jamais",
					"label": "Jamais",
					"scores": { "visibilite": 0, "fidelisation": 0 }
				},
				{
					"value": "mois",
					"label": "Quelques fois par mois",
					"scores": { "visibilite": 10, "fidelisation": 5 }
				},
				{
					"value": "semaine",
					"label": "Chaque semaine",
					"scores": { "visibilite": 20, "fidelisation": 15 }
				},
				{
					"value": "nsp",
					"label": "Je ne sais pas",
					"exit": { "mode": "neutral" }
				}
			]
		},
		{
			"key": "pause",
			"kind": "content",
			"section": "clients",
			"variant": "quote",
			"body": "<strong>76 %</strong> des personnes qui cherchent un commerce de proximité sur leur téléphone s'y rendent dans la journée.",
			"author": "Exemple de chiffre pour le test"
		},
		{
			"key": "avis",
			"kind": "question",
			"section": "clients",
			"type": "scale",
			"label": "Vos clients laissent-ils des avis en ligne ?",
			"validation": { "min": 1, "max": 5 },
			"scaleLabels": { "min": "Jamais", "max": "Très souvent" }
		},
		{
			"key": "relance",
			"kind": "question",
			"section": "clients",
			"type": "single",
			"label": "Comment restez-vous en contact avec vos clients ?",
			"options": [
				{
					"value": "rien",
					"label": "Je n'ai pas de suivi particulier",
					"scores": { "fidelisation": 0 }
				},
				{
					"value": "telephone",
					"label": "Par téléphone, au cas par cas",
					"scores": { "fidelisation": 15 }
				},
				{
					"value": "email",
					"label": "Newsletter ou emails réguliers",
					"scores": { "fidelisation": 35, "conversion": 10 }
				},
				{
					"value": "programme",
					"label": "Programme de fidélité",
					"scores": { "fidelisation": 45, "conversion": 10 }
				}
			]
		},
		{
			"key": "ca_actuel",
			"kind": "question",
			"section": "objectifs",
			"type": "amount",
			"label": "Quel est votre chiffre d'affaires mensuel actuel ?",
			"help": "Valeur approximative, elle sert uniquement à calculer votre objectif.",
			"currency": "EUR",
			"period": "month",
			"validation": { "min": 0 }
		},
		{
			"key": "ca_objectif",
			"kind": "question",
			"section": "objectifs",
			"type": "slider",
			"label": "Quel chiffre d'affaires mensuel visez-vous dans un an ?",
			"currency": "EUR",
			"validation": { "min": 0, "max": 200000, "step": 1000 }
		},
		{
			"key": "contact",
			"kind": "form",
			"section": "objectifs",
			"title": "Recevez votre résultat détaillé",
			"text": "Nous vous envoyons votre score et votre plan d'action par email.",
			"fields": [
				{ "key": "first_name", "type": "text", "label": "Prénom" },
				{
					"key": "email",
					"type": "email",
					"label": "Email",
					"required": true
				},
				{
					"key": "phone",
					"type": "phone",
					"label": "Téléphone (facultatif)"
				}
			],
			"consent": {
				"text": "J'accepte de recevoir mon résultat par email et d'être recontacté au sujet de ce diagnostic.",
				"version": "test-v1"
			},
			"submitLabel": "Voir mon résultat"
		}
	],
	"scoring": {
		"rules": [
			{
				"type": "range",
				"axis": "conversion",
				"question": "visites",
				"ranges": [
					{ "max": 100, "points": 5 },
					{ "min": 100, "max": 1000, "points": 20 },
					{ "min": 1000, "points": 35 }
				]
			},
			{
				"type": "range",
				"axis": "fidelisation",
				"question": "avis",
				"ranges": [
					{ "min": 1, "max": 3, "points": 5 },
					{ "min": 3, "max": 5, "points": 20 },
					{ "min": 5, "points": 35 }
				]
			},
			{
				"type": "count",
				"axis": "conversion",
				"question": "canaux",
				"ranges": [
					{ "min": 2, "max": 4, "points": 10 },
					{ "min": 4, "points": 20 }
				]
			},
			{
				"type": "condition",
				"axis": "visibilite",
				"when": {
					"left": "answer.canaux",
					"op": "contains",
					"value": "google"
				},
				"points": 10
			},
			{
				"type": "condition",
				"axis": "conversion",
				"when": {
					"left": "answer.site_web",
					"op": "eq",
					"value": false
				},
				"points": -5
			}
		]
	},
	"variables": [
		{
			"key": "ecart",
			"label": "Chiffre d'affaires supplémentaire visé",
			"expr": "max(0, answer.ca_objectif - answer.ca_actuel)",
			"format": { "style": "currency", "currency": "EUR", "decimals": 0 }
		},
		{
			"key": "progression",
			"label": "Progression visée",
			"expr": "answer.ca_actuel > 0 ? round((answer.ca_objectif - answer.ca_actuel) / answer.ca_actuel * 100) : 0",
			"format": { "style": "percent", "decimals": 0 }
		},
		{
			"key": "moyenne",
			"label": "Score global",
			"expr": "round((score.visibilite + score.conversion + score.fidelisation) / 3)",
			"format": { "decimals": 0, "suffix": "/ 100" }
		}
	],
	"outcomes": {
		"profiles": [
			{
				"key": "champion",
				"label": "Champion du digital",
				"text": "Bravo {first_name} ! Votre présence en ligne est solide. Il reste à l'optimiser pour transformer encore plus de visiteurs en clients.",
				"when": { "expr": "var.moyenne >= 60" },
				"priority": 30
			},
			{
				"key": "en_route",
				"label": "Sur la bonne voie",
				"text": "Les bases sont là, {first_name}. Quelques actions ciblées peuvent faire nettement progresser votre activité.",
				"when": { "expr": "var.moyenne >= 30" },
				"priority": 20
			},
			{
				"key": "debutant",
				"label": "Tout reste à construire",
				"text": "Bonne nouvelle {first_name} : chaque action aura un effet visible rapidement. Commencez par les fondamentaux ci-dessous.",
				"priority": 10
			}
		],
		"texts": [
			{
				"key": "faible_visibilite",
				"title": "Votre priorité : être trouvé",
				"body": "Votre point le plus faible est la <strong>visibilité</strong> : vos futurs clients ont du mal à vous trouver en ligne.",
				"when": {
					"left": "weakestAxis",
					"op": "eq",
					"value": "visibilite"
				}
			},
			{
				"key": "faible_conversion",
				"title": "Votre priorité : convertir",
				"body": "Votre point le plus faible est la <strong>conversion</strong> : on vous trouve, mais trop peu de visiteurs deviennent clients.",
				"when": {
					"left": "weakestAxis",
					"op": "eq",
					"value": "conversion"
				}
			},
			{
				"key": "faible_fidelisation",
				"title": "Votre priorité : fidéliser",
				"body": "Votre point le plus faible est la <strong>fidélisation</strong> : vos clients reviennent peu ou ne parlent pas de vous.",
				"when": {
					"left": "weakestAxis",
					"op": "eq",
					"value": "fidelisation"
				}
			},
			{
				"key": "objectif_ambitieux",
				"title": "Un objectif ambitieux",
				"body": "Vous visez une progression de plus de 50 % : un plan structuré sera indispensable.",
				"when": { "expr": "var.progression > 50" }
			}
		],
		"actions": [
			{
				"key": "fiche_google",
				"title": "Créez votre fiche Google",
				"body": "Gratuite et rapide, elle vous rend visible sur Google Maps et dans les recherches locales.",
				"when": {
					"left": "answer.canaux",
					"op": "notContains",
					"value": "google"
				},
				"priority": 30
			},
			{
				"key": "site",
				"title": "Lancez un site simple",
				"body": "Une page claire avec vos services, vos horaires et un bouton de contact suffit pour démarrer.",
				"when": {
					"left": "answer.site_web",
					"op": "eq",
					"value": false
				},
				"priority": 20
			},
			{
				"key": "avis_clients",
				"title": "Demandez des avis",
				"body": "Après chaque vente, envoyez un lien vers votre fiche Google : les avis rassurent vos futurs clients.",
				"when": { "left": "answer.avis", "op": "lt", "value": 4 },
				"priority": 10
			},
			{
				"key": "newsletter",
				"title": "Gardez le contact",
				"body": "Un email par mois (nouveautés, conseils, offres) suffit à faire revenir vos clients.",
				"when": {
					"left": "answer.relance",
					"op": "in",
					"value": [ "rien", "telephone" ]
				},
				"priority": 5
			}
		],
		"ctas": [
			{
				"key": "rdv_expert",
				"label": "Réserver un appel gratuit",
				"text": "Échangez 30 minutes avec un expert pour construire votre plan.",
				"url": "https://example.com/rendez-vous",
				"utm": {
					"source": "diagnostic",
					"medium": "resultat",
					"campaign": "presence-en-ligne",
					"content": "rdv"
				},
				"when": { "expr": "var.moyenne < 60" },
				"priority": 10
			},
			{
				"key": "guide",
				"label": "Télécharger le guide avancé",
				"text": "Vous êtes déjà bien avancé : passez au niveau supérieur.",
				"url": "https://example.com/guide",
				"utm": {
					"source": "diagnostic",
					"medium": "resultat",
					"campaign": "presence-en-ligne",
					"content": "guide"
				}
			}
		]
	},
	"results": {
		"title": "{first_name}, voici votre résultat",
		"shareLink": true,
		"emailResult": true,
		"blocks": [
			{ "type": "profile" },
			{ "type": "scores", "title": "Vos scores", "display": "radar" },
			{
				"type": "variables",
				"title": "Vos chiffres",
				"keys": [ "moyenne", "ecart", "progression" ]
			},
			{ "type": "texts", "title": "Ce qu'il faut retenir" },
			{ "type": "actions", "title": "Votre plan d'action" },
			{ "type": "cta" },
			{ "type": "share" }
		]
	},
	"integrations": {
		"emails": {
			"user": {
				"subject": "{first_name}, votre résultat de présence en ligne"
			},
			"admin": {
				"subject": "Nouveau diagnostic : {first_name} ({contact:email})"
			}
		}
	},
	"ui": {
		"theme": {
			"colors": {
				"primary": "#0f766e",
				"primaryText": "#ffffff",
				"surface": "#f0fdfa"
			},
			"radius": "10px"
		},
		"legal": "Vos données servent uniquement à vous envoyer votre résultat. Vous pouvez demander leur suppression à tout moment."
	}
}
