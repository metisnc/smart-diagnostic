	"scoring": {
		"rules": [
			{
				"type": "range",
				"axis": "presence",
				"question": "avis",
				"ranges": [
					{
						"max": 3,
						"points": 0
					},
					{
						"min": 3,
						"max": 4,
						"points": 14
					},
					{
						"min": 4,
						"max": 5,
						"points": 20
					},
					{
						"min": 5,
						"points": 28
					}
				]
			},
			{
				"type": "range",
				"axis": "culture",
				"question": "adoption",
				"ranges": [
					{
						"max": 3,
						"points": 5
					},
					{
						"min": 3,
						"max": 4,
						"points": 20
					},
					{
						"min": 4,
						"max": 5,
						"points": 35
					},
					{
						"min": 5,
						"points": 50
					}
				]
			}
		]
	},
	"variables": [
		{
			"key": "maturite",
			"label": {
				"fr": "Indice de maturité digitale",
				"en": "Digital maturity index"
			},
			"expr": "round((score.presence + score.outils + score.marketing + score.culture + score.cyber) / 5)",
			"format": {
				"decimals": 0,
				"suffix": {
					"fr": "/ 100",
					"en": "/ 100"
				}
			}
		},
		{
			"key": "niveau",
			"label": {
				"fr": "Niveau atteint",
				"en": "Level reached"
			},
			"expr": "var.maturite >= 75 ? 4 : (var.maturite >= 50 ? 3 : (var.maturite >= 25 ? 2 : 1))",
			"format": {
				"decimals": 0,
				"suffix": {
					"fr": "sur 4",
					"en": "of 4"
				}
			}
		}
	],
	"outcomes": {
		"profiles": [
			{
				"key": "leader",
				"label": {
					"fr": "Niveau 4 – Organisation pilotée par le numérique",
					"en": "Level 4 – Digitally driven organisation"
				},
				"text": {
					"fr": "Félicitations {first_name} ! Le numérique est au cœur de votre fonctionnement. Votre enjeu : rester à la pointe, automatiser davantage et valoriser vos données.",
					"en": "Congratulations {first_name}! Digital is at the heart of how you work. Your challenge: stay ahead, automate further and make the most of your data."
				},
				"when": {
					"left": "var.niveau",
					"op": "eq",
					"value": 4
				},
				"priority": 40
			},
			{
				"key": "structure",
				"label": {
					"fr": "Niveau 3 – Numérique structuré",
					"en": "Level 3 – Structured digital"
				},
				"text": {
					"fr": "Vos outils et vos pratiques sont en place, {first_name}. En reliant mieux vos données et en mesurant vos actions, vous gagnerez encore en efficacité.",
					"en": "Your tools and practices are in place, {first_name}. By connecting your data and measuring your actions, you will become even more efficient."
				},
				"when": {
					"left": "var.niveau",
					"op": "eq",
					"value": 3
				},
				"priority": 30
			},
			{
				"key": "progression",
				"label": {
					"fr": "Niveau 2 – Numérique en progression",
					"en": "Level 2 – Digital in progress"
				},
				"text": {
					"fr": "Les premières briques sont posées, {first_name}, mais elles restent dispersées. Quelques chantiers bien choisis vous feront franchir un cap.",
					"en": "The first building blocks are there, {first_name}, but they remain scattered. A few well-chosen projects will take you up a level."
				},
				"when": {
					"left": "var.niveau",
					"op": "eq",
					"value": 2
				},
				"priority": 20
			},
			{
				"key": "premiers_pas",
				"label": {
					"fr": "Niveau 1 – Premiers pas numériques",
					"en": "Level 1 – First digital steps"
				},
				"text": {
					"fr": "Tout reste à construire, {first_name}, et c’est une bonne nouvelle : chaque action simple aura un effet visible rapidement. Commencez par les priorités ci-dessous.",
					"en": "Everything is still to build, {first_name}, and that is good news: every simple action will have a visible effect quickly. Start with the priorities below."
				},
				"priority": 10
			}
		],
		"texts": [
			{
				"key": "faible_presence",
				"title": {
					"fr": "Axe prioritaire : présence en ligne",
					"en": "Priority area: online presence"
				},
				"body": {
					"fr": "Vos clients potentiels ont du mal à vous trouver et à vous évaluer en ligne. C’est la première porte d’entrée de votre activité.",
					"en": "Potential customers struggle to find and assess you online. It is the front door to your business."
				},
				"when": {
					"all": [
						{
							"left": "weakestAxis",
							"op": "eq",
							"value": "presence"
						},
						{
							"left": "score.presence",
							"op": "lt",
							"value": 70
						}
					]
				}
			},
			{
				"key": "faible_outils",
				"title": {
					"fr": "Axe prioritaire : outils et données",
					"en": "Priority area: tools and data"
				},
				"body": {
					"fr": "Vos informations sont dispersées : vous perdez du temps et des opportunités. Centraliser vos données est un levier rapide.",
					"en": "Your information is scattered, costing you time and opportunities. Centralising your data is a quick win."
				},
				"when": {
					"all": [
						{
							"left": "weakestAxis",
							"op": "eq",
							"value": "outils"
						},
						{
							"left": "score.outils",
							"op": "lt",
							"value": 70
						}
					]
				}
			},
			{
				"key": "faible_marketing",
				"title": {
					"fr": "Axe prioritaire : marketing digital",
					"en": "Priority area: digital marketing"
				},
				"body": {
					"fr": "Vos actions marketing en ligne sont encore limitées ou peu mesurées. Quelques actions régulières et suivies suffisent pour commencer.",
					"en": "Your online marketing is still limited or barely measured. A few regular, tracked actions are enough to get started."
				},
				"when": {
					"all": [
						{
							"left": "weakestAxis",
							"op": "eq",
							"value": "marketing"
						},
						{
							"left": "score.marketing",
							"op": "lt",
							"value": 70
						}
					]
				}
			},
			{
				"key": "faible_culture",
				"title": {
					"fr": "Axe prioritaire : culture et compétences",
					"en": "Priority area: culture and skills"
				},
				"body": {
					"fr": "Les outils ne suffisent pas sans l’adhésion des équipes. Investir dans les compétences accélérera tous les autres axes.",
					"en": "Tools are not enough without team buy-in. Investing in skills will speed up every other area."
				},
				"when": {
					"all": [
						{
							"left": "weakestAxis",
							"op": "eq",
							"value": "culture"
						},
						{
							"left": "score.culture",
							"op": "lt",
							"value": 70
						}
					]
				}
			},
			{
				"key": "faible_cyber",
				"title": {
					"fr": "Axe prioritaire : cybersécurité",
					"en": "Priority area: cybersecurity"
				},
				"body": {
					"fr": "Votre protection est votre point le plus fragile. Une perte de données ou un piratage peut paralyser votre activité : quelques mesures simples réduisent fortement ce risque.",
					"en": "Protection is your weakest point. Data loss or hacking can paralyse your business, and a few simple measures greatly reduce this risk."
				},
				"when": {
					"all": [
						{
							"left": "weakestAxis",
							"op": "eq",
							"value": "cyber"
						},
						{
							"left": "score.cyber",
							"op": "lt",
							"value": 70
						}
					]
				}
			},
			{
				"key": "alerte_cyber",
				"title": {
					"fr": "Alerte sécurité",
					"en": "Security alert"
				},
				"body": {
					"fr": "Votre score de cybersécurité est inférieur à 40 / 100. Nous vous recommandons de traiter ce point en priorité, quel que soit votre niveau global.",
					"en": "Your cybersecurity score is below 40 / 100. We recommend tackling this first, whatever your overall level."
				},
				"when": {
					"all": [
						{
							"left": "score.cyber",
							"op": "lt",
							"value": 40
						},
						{
							"not": {
								"all": [
									{
										"left": "weakestAxis",
										"op": "eq",
										"value": "cyber"
									},
									{
										"left": "score.cyber",
										"op": "lt",
										"value": 70
									}
								]
							}
						}
					]
				}
			}
		],
		"actions": [
			{
				"key": "act_sauvegarde",
				"title": {
					"fr": "Automatisez vos sauvegardes",
					"en": "Automate your backups"
				},
				"body": {
					"fr": "Mettez en place une sauvegarde automatique, dont une copie hors de vos locaux, et testez une restauration chaque trimestre.",
					"en": "Set up automatic backups, with one copy off-site, and test a restore every quarter."
				},
				"when": {
					"left": "answer.sauvegardes",
					"op": "in",
					"value": [ "aucune", "manuelle", "nsp" ]
				},
				"priority": 60
			},
			{
				"key": "act_double_auth",
				"title": {
					"fr": "Activez la double authentification",
					"en": "Turn on two-factor authentication"
				},
				"body": {
					"fr": "Commencez par la messagerie, la banque et les outils de gestion : c’est l’une des protections les plus efficaces.",
					"en": "Start with email, banking and business tools: it is one of the most effective protections."
				},
				"when": {
