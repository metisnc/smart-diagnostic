		"title": {
			"fr": "Audit de maturité digitale",
			"en": "Digital maturity audit"
		},
		"description": {
			"fr": "Un audit en 14 questions qui situe une organisation sur 4 niveaux de maturité numérique, à travers 5 axes (présence en ligne, outils et données, marketing digital, culture et compétences, cybersécurité), avec un plan d’action priorisé.",
			"en": "A 14-question audit placing an organisation on 4 digital maturity levels across 5 areas (online presence, tools and data, digital marketing, culture and skills, cybersecurity), with a prioritised action plan."
		}
	},
	"i18n": {
		"defaultLanguage": "fr",
		"languages": [ "fr", "en" ],
		"switcher": true
	},
	"welcome": {
		"title": {
			"fr": "Où en est votre organisation avec le numérique ?",
			"en": "Where does your organisation stand with digital?"
		},
		"subtitle": {
			"fr": "En 5 minutes, mesurez votre maturité digitale sur 5 axes et recevez un plan d’action adapté à votre niveau.",
			"en": "In 5 minutes, measure your digital maturity across 5 areas and get an action plan tailored to your level."
		},
		"benefits": [
			{
				"fr": "Votre niveau de maturité parmi 4 paliers",
				"en": "Your maturity level out of 4 stages"
			},
			{
				"fr": "Un score détaillé sur 5 axes",
				"en": "A detailed score across 5 areas"
			},
			{
				"fr": "Un plan d’action priorisé",
				"en": "A prioritised action plan"
			},
			{
				"fr": "Un point d’attention sur votre cybersécurité",
				"en": "A focus on your cybersecurity"
			}
		],
		"badges": [
			{
				"fr": "Gratuit",
				"en": "Free"
			},
			{
				"fr": "5 minutes",
				"en": "5 minutes"
			},
			{
				"fr": "14 questions",
				"en": "14 questions"
			}
		],
		"resultPreview": true,
		"startLabel": {
			"fr": "Lancer l’audit",
			"en": "Start the audit"
		}
	},
