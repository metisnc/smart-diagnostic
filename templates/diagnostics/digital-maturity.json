				"key": "act_incident",
				"title": {
					"fr": "Rédigez votre fiche réflexe incident",
					"en": "Write an incident quick-reference sheet"
				},
				"body": {
					"fr": "Une page suffit : qui prévenir, quoi débrancher, où sont les sauvegardes. Partagez-la avec toute l’équipe.",
					"en": "One page is enough: who to call, what to disconnect, where the backups are. Share it with the whole team."
				},
				"when": {
					"left": "answer.incident",
					"op": "eq",
					"value": false
				},
				"priority": 50
			},
			{
