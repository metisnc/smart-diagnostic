				"title": {
					"fr": "Faites de votre site un outil de contact",
					"en": "Turn your website into a contact tool"
				},
				"body": {
					"fr": "Ajoutez un formulaire, une prise de rendez-vous ou un appel à l’action clair sur chaque page.",
					"en": "Add a form, booking option or clear call to action on every page."
				},
				"when": {
					"left": "answer.site",
					"op": "in",
					"value": [ "aucun", "basique", "vitrine" ]
				},
				"priority": 40
			},
			{
				"key": "act_fiche",
				"title": {
					"fr": "Créez ou complétez votre fiche d’établissement",
					"en": "Create or complete your business listing"
				},
				"body": {
					"fr": "Horaires, photos, services : une fiche complète améliore nettement votre visibilité locale.",
					"en": "Opening hours, photos, services: a complete listing clearly improves local visibility."
				},
				"when": {
					"left": "answer.canaux",
					"op": "notContains",
					"value": "fiche"
				},
				"priority": 35
			},
			{
				"key": "act_donnees",
				"title": {
					"fr": "Centralisez vos données clients",
					"en": "Centralise your customer data"
				},
				"body": {
					"fr": "Choisissez un outil unique, accessible à l’équipe, et fixez des règles simples de saisie.",
					"en": "Pick a single tool the team can access and set simple data-entry rules."
				},
				"when": {
					"left": "answer.donnees",
					"op": "in",
					"value": [ "papier", "disperse" ]
				},
				"priority": 30
			},
			{
				"key": "act_mesure",
				"title": {
					"fr": "Mesurez vos actions marketing",
					"en": "Measure your marketing"
				},
				"body": {
					"fr": "Fixez un objectif par action (contacts, visites, ventes) et faites le point chaque mois.",
					"en": "Set one goal per action (leads, visits, sales) and review it monthly."
				},
				"when": {
					"left": "answer.mesure",
					"op": "in",
					"value": [ "non", "parfois", "nsp" ]
				},
				"priority": 25
			},
			{
				"key": "act_formation",
				"title": {
					"fr": "Planifiez la montée en compétences",
					"en": "Plan skills development"
				},
				"body": {
					"fr": "Identifiez deux compétences clés à renforcer cette année et prévoyez un temps dédié pour chaque collaborateur.",
					"en": "Identify two key skills to strengthen this year and set aside dedicated time for each team member."
				},
				"when": {
					"expr": "score.culture < 50"
				},
				"priority": 20
			},
			{
				"key": "act_automatiser",
				"title": {
					"fr": "Automatisez et connectez vos outils",
					"en": "Automate and connect your tools"
				},
				"body": {
					"fr": "Vous êtes bien équipé : reliez vos outils entre eux pour supprimer les doubles saisies.",
					"en": "You are well equipped: connect your tools to remove duplicate data entry."
				},
				"when": {
