{
  "name": "smart-diagnostic",
  "version": "1.0.0",
  "private": true,
  "description": "Moteur de questionnaires de diagnostic interactifs pour WordPress, en marque blanche.",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "lint": "npm run lint:js && npm run format:check",
    "lint:js": "wp-scripts lint-js assets/src tests/js tests/e2e",
    "format": "prettier --write \"assets/src/**/*.{js,jsx,scss}\" \"tests/**/*.js\" \"examples/*.json\" \"schema/*.json\"",
    "format:check": "prettier --check \"assets/src/**/*.{js,jsx,scss}\" \"tests/**/*.js\" \"examples/*.json\" \"schema/*.json\"",
    "test": "wp-scripts test-unit-js",
    "test:e2e": "playwright test",
    "size": "node bin/check-bundle-size.js"
  },
  "dependencies": {
    "preact": "^10.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@wordpress/scripts": "^30.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "prettier": "npm:wp-prettier@^3.0.3",
    "typescript": "^5.9.3"
  }
}
