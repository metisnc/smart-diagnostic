# Copié en .env par bin/setup-local.sh ; les valeurs "change-me" sont remplacées
# par des mots de passe aléatoires. Ne jamais versionner .env.

# Accès au site
WP_URL=http://localhost:8080
WP_BIND=127.0.0.1
WP_PORT=8080
WP_TITLE="Smart Diagnostic — dev"
WP_DEBUG=1
# Langue du site (Réglages → Général) : fr_FR, en_US…
WP_LOCALE=fr_FR

# Aides aux tests E2E (capture des emails, récepteur de webhooks) : jamais en production.
SD_TEST_HELPERS=1
# Compte utilisé par les tests E2E (créé si SD_TEST_HELPERS=1), admin en anglais.
E2E_ADMIN_USER=e2e
E2E_ADMIN_PASSWORD=change-me

# Administrateur WordPress
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change-me
WP_ADMIN_EMAIL=admin@example.test

# Base de données
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me

# phpMyAdmin (lié à 127.0.0.1 par défaut : accès via tunnel SSH sur la VM)
PMA_BIND=127.0.0.1
PMA_PORT=8081
